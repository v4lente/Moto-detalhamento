# Database (MySQL)
# Opções de MySQL gratuito:
# 1. Railway: https://railway.app (mais fácil)
# 2. TiDB Serverless: https://tidbcloud.com (recomendado para produção)
# 3. PlanetScale: https://planetscale.com
# 4. Aiven: https://aiven.io
#
# Formato da URL:
DATABASE_URL=mysql://user:password@host:3306/database
# Exemplo TiDB: mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/database?ssl=true

# Session Security (REQUIRED in production)
# Generate a strong random string: openssl rand -base64 32
SESSION_SECRET=your-strong-random-secret-at-least-32-characters

# Current release persists normalized customer documents in document_plaintext.
# Encryption settings below are retained only for legacy rows and a future
# protected-storage migration.
CUSTOMER_DOCUMENT_KEY=
CUSTOMER_DOCUMENT_KEY_VERSION=1
CUSTOMER_DOCUMENT_HMAC_SECRET=
# Optional JSON key ring for decrypting documents encrypted with previous versions.
# Keep the active key in CUSTOMER_DOCUMENT_KEY and add older keys by version, e.g.:
# CUSTOMER_DOCUMENT_KEYS={"1":"<base64-key-v1>","2":"<base64-key-v2>"}
CUSTOMER_DOCUMENT_KEYS=

# Uploads (optional)
# In production, point this to a persistent directory outside the deploy folder
# so images uploaded in the admin survive redeploys.
# UPLOADS_DIR=/home/username/domains/your-domain.com/uploads

# Stripe (optional - enables online payments)
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (for production)
# Get this from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL for redirects (optional, defaults to http://localhost:5000)
# Set this in production to your actual domain
BASE_URL=https://your-domain.com
